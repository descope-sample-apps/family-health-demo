# Required. Your Descope project ID.
NEXT_PUBLIC_DESCOPE_PROJECT_ID=<your Descope project ID>

# Required. Management key, used server-side only (never exposed to the browser) by /api/family,
# /api/family/impersonate*, /api/me and /api/profile.
DESCOPE_MANAGEMENT_KEY=<management key>

# Optional. The sign-in flow to render; defaults to sign-up-or-in.
NEXT_PUBLIC_DESCOPE_FLOW_ID=sign-up-or-in

# Optional. Leave unset to use Descope's production API. Only set this to target a non-default
# Descope environment.
# NEXT_PUBLIC_DESCOPE_BASE_URL=
